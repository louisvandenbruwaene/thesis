# Python
__pycache__/
*.pyc

# Program run logs.  The transcripts the thesis and the program cite are tracked
# already, by force-add, so this rule only keeps the scratch logs of later runs
# out of the repository.  It said "the four transcripts" while six were tracked,
# so it carries no count now.
program/logs/

# A rebuild in progress. Scratch state, promoted into machine_values.json by
# --promote once it has been reviewed, and of no use to anyone else.
program/data/machine_values.candidate.json

# LaTeX build artifacts (the built main.pdf IS committed on purpose)
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.log
*.out
*.toc
*.loa
*.lof
*.lot
revision.tex
*.synctex.gz
*.nav
*.snm
program/erdos915_unified.baseline.py
program/_erdos_fast.so

# Python virtualenv (per-machine; not part of the deliverable)
.venv/

# macOS
.DS_Store

# Beamer build products for the talk decks
slides/talk_*.aux
slides/talk_*.log
slides/talk_*.nav
slides/talk_*.out
slides/talk_*.snm
slides/talk_*.toc
slides/talk_*.fls
slides/talk_*.fdb_latexmk
sorensen.pdf

# author working files and third-party PDFs, kept locally only
current status thesis.rtf
directed_multigraph_extremal_revised.pdf

# The offcuts record builds from offcuts.tex; the PDF is a build product
offcuts.pdf


# Hand-in bundle built by git archive; regenerate, never edit.
handin/

# Everything else in this working tree IS tracked, on the private main branch.
# The public repository at origin is a generated snapshot built by publish.sh
# and carries only main.pdf, program/ and README.md, so privacy is handled by
# what publish.sh copies across, never by this file.

# The public snapshot worktree, created and removed by publish.sh.
.public-snapshot/

# Benchmark runner mutexes. Transient, and program/ rides into the hand-in
# through git archive, so they must not be tracked.
program/data/**/*.lock
