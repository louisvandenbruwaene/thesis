@article{Leonard73BE,
    author = {Leonard, John L.},
    title = {On a Conjecture of {B}ollob\'{a}s and {E}rd{\H{o}}s},
    journal = {Periodica Mathematica Hungarica},
    volume = {3},
    number = {3--4},
    pages = {281--284},
    year = {1973},
    doi = {10.1007/BF02018594},
    note = {Gives the explicit $m = 5$ counterexample, on 57 vertices and 141 edges, and a constant $c > 0$ with $k_5(n) > (5/2 + c)n - O(1)$. The $m \le 4$ equality is from Leonard's 1972 paper, not this one}
}

@article{Leonard72b,
    author = {Leonard, John L.},
    title = {On Graphs with at Most Four Line-Disjoint Paths Connecting any Two Vertices},
    journal = {Journal of Combinatorial Theory, Series B},
    volume = {13},
    pages = {242--250},
    year = {1972},
    doi = {10.1016/0095-8956(72)90059-7},
    note = {``Line-disjoint'' is edge-disjoint and ``at most four'' is $\lambda^{\max} \le 4$, so the title names the edge problem at $m = 5$. The paper also proves $\ell_m(n) = k_m(n)$ for $2 \le m \le 4$, which is the equality stated in Chapter~1}
}

@article{Leonard73,
    author = {Leonard, John L.},
    title = {Graphs with 6-Ways},
    journal = {Canadian Journal of Mathematics},
    volume = {25},
    pages = {687--692},
    year = {1973},
    doi = {10.4153/CJM-1973-069-x},
    note = {Determines $\ell_6(n)$, the edge value one step past Leonard's own $m = 5$}
}

@article{SorensenThomassen74,
    author = {S{\o}rensen, B. A. and Thomassen, Carsten},
    title = {On $k$-Rails in Graphs},
    journal = {Journal of Combinatorial Theory, Series B},
    volume = {17},
    number = {2},
    pages = {143--159},
    year = {1974},
    doi = {10.1016/0095-8956(74)90082-3},
    note = {Theorem 4 determines $f_5(n) = \lfloor 8n/3 \rfloor - 3$ for $n \ge 6$, $n \ne 7$, $n \ne 12$. Their $f_k(n)$ is the least edge count that forces a $k$-rail, one more than this thesis's $k_m(n)$, so the value here is $\lfloor 8n/3 \rfloor - 4$. The same paper gives the general lower bound on $c_m$ and proves that the Bollob\'{a}s--Erd\H{o}s bound does hold for $3$-connected graphs}
}

